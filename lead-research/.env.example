# Copy to .env.local and fill in.

# Real mode: Scout fetches each homepage and calls the model.
OPENAI_API_KEY=
OPENAI_MODEL=

# Demo mode runs automatically when OPENAI_API_KEY is empty: precomputed
# results for seed/sample_leads.csv, no network or API calls.
# DEMO_MODE=1 forces demo mode even with a key; DEMO_MODE=0 forces real mode.
# DEMO_MODE=
# Average time per pipeline step in demo mode, in milliseconds (default 650).
# DEMO_STEP_MS=
